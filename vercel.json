{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/return-policy",
      "destination": "/return-policy.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-translate",
      "schedule": "0 5 * * *"
    }
  ]
}
